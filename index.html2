<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>HAPPYCLEAN 작업관리</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}body{margin:0;background:#f5f6f8;color:#111;font-family:-apple-system,BlinkMacSystemFont,"Noto Sans KR",sans-serif}
header{background:#111;color:#fff;padding:16px;position:sticky;top:0;z-index:5}.wrap{max-width:900px;margin:auto;padding:14px}
.card{background:#fff;border-radius:15px;padding:16px;margin:12px 0;box-shadow:0 2px 8px #0000000d}
h1,h2{margin:4px 0 14px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
input,select,textarea,button{width:100%;font:inherit;padding:12px;border-radius:10px;border:1px solid #ddd;margin:5px 0}
textarea{min-height:80px;resize:vertical}button{background:#111;color:#fff;border:0;font-weight:700}
button.secondary{background:#eef0f2;color:#111}.muted{font-size:13px;color:#666}.hidden{display:none!important}
.notice{background:#f0f5ff;border-radius:10px;padding:10px;font-size:13px}.danger{color:#b42318}.ok{color:#067647}
.photos{display:flex;gap:8px;overflow:auto;margin:6px 0 12px}.photos img{width:90px;height:90px;object-fit:cover;border-radius:9px}
.job{border:1px solid #eee;border-radius:11px;padding:12px;margin:8px 0}.job a{color:#0b63ce}.topline{display:flex;justify-content:space-between;gap:8px}
@media(max-width:600px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><div class="wrap"><b>HAPPYCLEAN · 온라인 작업관리</b></div></header>
<div class="wrap">

<section id="loginCard" class="card">
<h2>직원 로그인</h2>
<p id="accessStatus" class="muted"></p>
<p class="muted">해피크린 작업관리 계정으로 로그인하세요.</p>
<input id="email" type="email" placeholder="이메일">
<input id="password" type="password" placeholder="비밀번호">
<button onclick="login()">로그인</button>
<div id="loginMsg" class="muted"></div>
</section>

<main id="app" class="hidden">
<div class="card">
<div class="topline"><h2>작업 등록</h2><button style="width:auto;padding:8px 12px" onclick="logout()">로그아웃</button></div>
<div class="grid">
<div><label>작업일</label><input id="date" type="date"></div>
<div><label>고객명</label><input id="name"></div>
</div>
<div class="grid"><input id="phone" placeholder="연락처"><input id="address" placeholder="주소"></div>
<textarea id="note" placeholder="특이사항"></textarea>
<div class="grid"><input id="type" placeholder="에어컨 종류"><input id="qty" type="number" value="1" min="1" placeholder="수량"></div>
<div class="grid"><input id="maker" placeholder="제조사"><input id="model" placeholder="모델명"></div>
<div class="grid"><input id="price" type="number" value="0" placeholder="작업금액">
<select id="payment"><option>미결제</option><option>현금</option><option>카드</option><option>계좌이체</option></select></div>

<div id="hospitalNotice" class="notice hidden">10월 1일 작업은 <b>성빈센트병원</b>으로 자동 입력됩니다. 고객명·연락처·주소 없이도 저장할 수 있습니다.</div>

<label>작업 전 사진 — 최소 1장</label><div class="muted">사진을 추가로 선택하면 기존 사진에 계속 추가됩니다.</div>
<input id="before" type="file" accept="image/*" capture="environment" multiple>
<div id="beforePrev" class="photos"></div>

<label>작업 후 사진 — 최소 1장</label><div class="muted">사진을 추가로 선택하면 기존 사진에 계속 추가됩니다.</div>
<input id="after" type="file" accept="image/*" capture="environment" multiple>
<div id="afterPrev" class="photos"></div>

<button onclick="saveJob()">작업 저장</button>
<div id="saveMsg" class="muted"></div>
</div>

<div class="card">
<h2>작업 이력</h2>
<input id="search" placeholder="고객명 / 연락처 / 주소 검색" oninput="loadJobs()">
<div id="jobs"></div>
</div>
</main>
</div>

<script>
const SUPABASE_URL = "https://lltfyjixbdnulfkrzanu.supabase.co";
const SUPABASE_KEY = "sb_publishable_8mfh36Ulp8kCQtdM7fLfUA_IpszyJXD";
const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
const BUCKET = "happyclean-photos";
const $=id=>document.getElementById(id);

function localDate(){let d=new Date();let off=d.getTimezoneOffset();d=new Date(d.getTime()-off*60000);return d.toISOString().slice(0,10)}
$("date").value=localDate();

function applyDateRule(){
  if($("date").value==="2026-10-01"){
    $("name").value="성빈센트병원";
    $("hospitalNotice").classList.remove("hidden");
  } else $("hospitalNotice").classList.add("hidden");
}
$("date").onchange=applyDateRule; applyDateRule();

let beforeFiles=[];
let afterFiles=[];

function fileKey(f){
  return `${f.name}|${f.size}|${f.lastModified}`;
}

function addFiles(input, type, box){
  const target = type==="before" ? beforeFiles : afterFiles;
  for(const f of [...input.files]){
    // 같은 파일을 실수로 두 번 선택한 경우에는 중복 추가하지 않음
    if(!target.some(x=>fileKey(x)===fileKey(f))) target.push(f);
  }
  input.value="";
  renderPhotos(type, box);
}

function renderPhotos(type, box){
  const target = type==="before" ? beforeFiles : afterFiles;
  box.innerHTML="";
  target.forEach((f,i)=>{
    const wrap=document.createElement("div");
    wrap.style.cssText="position:relative;flex:0 0 auto";
    const img=document.createElement("img");
    img.src=URL.createObjectURL(f);
    const del=document.createElement("button");
    del.textContent="×";
    del.style.cssText="position:absolute;right:2px;top:2px;width:28px;height:28px;padding:0;margin:0;border-radius:50%;background:#111;color:#fff";
    del.onclick=()=>{
      target.splice(i,1);
      renderPhotos(type,box);
    };
    wrap.appendChild(img);wrap.appendChild(del);box.appendChild(wrap);
  });
}

$("before").onchange=()=>addFiles($("before"),"before",$("beforePrev"));
$("after").onchange=()=>addFiles($("after"),"after",$("afterPrev"));

async function login(){
  $("loginMsg").textContent="";

  // 2026-10-01까지: 정보 입력 없이 버튼만 눌러도 임시 로그인
  if(!requiresLogin()){
    window.tempLogin=true;
    showState(null);
    $("loginMsg").textContent="로그인되었습니다.";
    return;
  }

  // 2026-10-02부터: 실제 이메일/비밀번호 인증 필수
  const email=$("email").value.trim();
  const password=$("password").value;

  if(!email || !password){
    $("loginMsg").textContent="10월 2일부터는 이메일과 비밀번호를 입력해야 합니다.";
    return;
  }

  $("loginMsg").textContent="로그인 중...";
  const {error}=await sb.auth.signInWithPassword({email,password});

  if(error){
    $("loginMsg").textContent=error.message;
    return;
  }

  $("loginMsg").textContent="로그인되었습니다.";
}
async function logout(){
  window.tempLogin=false;
  await sb.auth.signOut();
  showState(null);
}


function localDate(){
  const d=new Date();
  const off=d.getTimezoneOffset();
  return new Date(d.getTime()-off*60000).toISOString().slice(0,10);
}
function requiresLogin(){
  return localDate() >= "2026-10-02";
}
async function init(){
  const {data:{session}}=await sb.auth.getSession();
  showState(session);
  sb.auth.onAuthStateChange((_e,s)=>showState(s));
}
function showState(session){
  const mustLogin=requiresLogin();

  // 로그인 화면은 항상 먼저 표시한다.
  // 10/1까지는 로그인 버튼만 누르면 임시 로그인으로 진입.
  // 10/2부터는 실제 Supabase 로그인 세션이 있어야 진입.
  $("loginCard").classList.toggle("hidden", !!session || window.tempLogin === true);
  $("app").classList.toggle("hidden", !(session || window.tempLogin === true));

  const notice=$("accessStatus");
  if(notice){
    notice.textContent=mustLogin
      ? "현재는 이메일과 비밀번호를 입력한 계정 로그인만 사용할 수 있습니다."
      : "10월 1일까지는 로그인 정보를 입력하지 않고 로그인 버튼만 눌러도 작업등록 화면으로 들어갈 수 있습니다.";
  }

  if(session) loadJobs();
}

function readFiles(input){
  return Promise.all([...input.files].map(f=>new Promise((resolve,reject)=>{
    const r=new FileReader();
    r.onload=()=>resolve({file:f,data:r.result});
    r.onerror=reject;r.readAsDataURL(f);
  })));
}
async function compress(file){
  if(!file.type.startsWith("image/")) return file;
  const img=await new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=rej;i.src=URL.createObjectURL(file)});
  const max=1600, ratio=Math.min(1,max/Math.max(img.width,img.height));
  const c=document.createElement("canvas");c.width=Math.round(img.width*ratio);c.height=Math.round(img.height*ratio);
  c.getContext("2d").drawImage(img,0,0,c.width,c.height);
  return await new Promise(res=>c.toBlob(b=>res(new File([b],file.name.replace(/\.[^.]+$/,"")+".jpg",{type:"image/jpeg"})),"image/jpeg",.78));
}

async function saveJob(){
  const mustLogin=requiresLogin();
  const {data:{session}}=await sb.auth.getSession();

  if(mustLogin && !session){
    alert("2026년 10월 2일부터는 실제 계정으로 로그인 후 작업을 등록할 수 있습니다.");
    return;
  }
  if(!mustLogin && !session && !window.tempLogin){
    alert("로그인 버튼을 먼저 눌러주세요.");
    return;
  }

  const before=[...beforeFiles], after=[...afterFiles];

  $("saveMsg").textContent="저장 중...";
  const workDate=$("date").value;
  const customerName=workDate==="2026-10-01" ? "성빈센트병원" : $("name").value.trim();

  // 무로그인 기간에는 ID를 브라우저에서 생성하여 INSERT 후 SELECT가 필요 없도록 함.
  const jobId=crypto.randomUUID();
  const {error:jobError}=await sb.from("jobs").insert({
    id:jobId,
    work_date:workDate,
    customer_name:customerName,
    phone:$("phone").value.trim(),
    address:$("address").value.trim(),
    note:$("note").value.trim(),
    ac_type:$("type").value.trim(),
    qty:Number($("qty").value)||1,
    maker:$("maker").value.trim(),
    model:$("model").value.trim(),
    price:Number($("price").value)||0,
    payment:$("payment").value
  });

  if(jobError){
    $("saveMsg").textContent=jobError.message;
    return;
  }

  const all=[["before",before],["after",after]];
  let photoRows=[];
  for(const [type,files] of all){
    for(let i=0;i<files.length;i++){
      const f=await compress(files[i]);
      const path=`${jobId}/${type}/${Date.now()}_${i}_${crypto.randomUUID()}.jpg`;
      const {error}=await sb.storage.from(BUCKET).upload(path,f,{
        contentType:"image/jpeg",
        upsert:false
      });
      if(error){
        $("saveMsg").textContent="사진 업로드 실패: "+error.message;
        return;
      }
      photoRows.push({
        job_id:jobId,
        photo_type:type,
        storage_path:path,
        original_name:files[i].name,
        sort_order:i
      });
    }
  }

  const {error:photoError}=await sb.from("job_photos").insert(photoRows);
  if(photoError){
    $("saveMsg").textContent=photoError.message;
    return;
  }

  $("saveMsg").innerHTML=`<span class="ok">저장 완료</span> · 작업번호 ${jobId}`;
  beforeFiles=[];afterFiles=[];
  $("before").value="";$("after").value="";
  $("beforePrev").innerHTML="";$("afterPrev").innerHTML="";
  if(session) loadJobs();
}

async function loadJobs(){
  const {data:{session}}=await sb.auth.getSession();
  if(!session){
    $("jobs").innerHTML="<p class='muted'>10월 1일까지는 등록만 가능합니다. 작업 이력은 로그인 후 확인할 수 있습니다.</p>";
    return;
  }
  const q=($("search").value||"").trim();
  let query=sb.from("jobs").select("*").order("work_date",{ascending:false}).order("created_at",{ascending:false}).limit(100);
  if(q) query=query.or(`customer_name.ilike.%${q}%,phone.ilike.%${q}%,address.ilike.%${q}%`);
  const {data,error}=await query;
  if(error){$("jobs").innerHTML=`<p class="danger">${error.message}</p>`;return}
  $("jobs").innerHTML=(data||[]).map(j=>`
    <div class="job">
      <b>${j.work_date} · ${esc(j.customer_name||"고객정보 없음")}</b><br>
      ${esc(j.ac_type||"")} ${j.qty||1}대 · ${Number(j.price||0).toLocaleString()}원<br>
      <span class="muted">${esc(j.address||"")}</span>
      <div><button class="secondary" style="width:auto" onclick="viewJob('${j.id}')">상세보기</button></div>
    </div>`).join("") || "<p class='muted'>등록된 작업이 없습니다.</p>";
}

async function viewJob(id){
  const {data:j,error}=await sb.from("jobs").select("*").eq("id",id).single();
  if(error){alert(error.message);return}
  const {data:p}=await sb.from("job_photos").select("*").eq("job_id",id).order("photo_type").order("sort_order");
  let html=`<h3>${esc(j.work_date)} · ${esc(j.customer_name||"")}</h3><p>${esc(j.ac_type||"")} ${j.qty||1}대 / ${Number(j.price||0).toLocaleString()}원</p>`;
  for(const type of ["before","after","extra"]){
    const arr=(p||[]).filter(x=>x.photo_type===type); if(!arr.length)continue;
    html+=`<b>${type==="before"?"작업 전":type==="after"?"작업 후":"추가"} 사진</b><div class="photos">`;
    for(const x of arr){
      const {data:u}=await sb.storage.from(BUCKET).createSignedUrl(x.storage_path,3600);
      if(u?.signedUrl)html+=`<img src="${u.signedUrl}">`;
    }
    html+="</div>";
  }
  const win=window.open("","_blank");win.document.write(`<meta name="viewport" content="width=device-width,initial-scale=1"><body style="font-family:sans-serif;padding:20px">${html}
<!--
SUPABASE SQL EDITOR: 2026-10-01까지 무로그인 등록을 허용하려면 1회 실행.
10월 2일에는 아래 3개 정책을 삭제해야 함.

create policy "temporary anon insert jobs"
on public.jobs for insert to anon with check (true);

create policy "temporary anon insert job photos"
on public.job_photos for insert to anon with check (true);

create policy "temporary anon upload photos"
on storage.objects for insert to anon
with check (bucket_id = 'happyclean-photos');

10월 2일 이후 삭제:
drop policy if exists "temporary anon insert jobs" on public.jobs;
drop policy if exists "temporary anon insert job photos" on public.job_photos;
drop policy if exists "temporary anon upload photos" on storage.objects;
-->

</body>`);
}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[m]))}
init();
</script>

<!--
SUPABASE SQL EDITOR: 2026-10-01까지 무로그인 등록을 허용하려면 1회 실행.
10월 2일에는 아래 3개 정책을 삭제해야 함.

create policy "temporary anon insert jobs"
on public.jobs for insert to anon with check (true);

create policy "temporary anon insert job photos"
on public.job_photos for insert to anon with check (true);

create policy "temporary anon upload photos"
on storage.objects for insert to anon
with check (bucket_id = 'happyclean-photos');

10월 2일 이후 삭제:
drop policy if exists "temporary anon insert jobs" on public.jobs;
drop policy if exists "temporary anon insert job photos" on public.job_photos;
drop policy if exists "temporary anon upload photos" on storage.objects;
-->
 
</body></html>
